# Configuración de la NoC para una topología de MESH 8x8 (Python SimPy)

# Tipo de topología (MESH, TORUS, etc.)
TOPOLOGY_TYPE=MESH

# Dimensiones de la malla
MESH_DIM_X=8
MESH_DIM_Y=8

# Número total de nodos (calculado como MESH_DIM_X * MESH_DIM_Y)
NUM_NODES=64

# Buffer size (en flits) para los buffers de entrada de los routers (Aumentado para evitar congestión)
BUFFER_SIZE=128

# Algoritmo de enrutamiento (XY, WEST_FIRST, NORTH_LAST, etc.)
ROUTING_ALGORITHM=XY

# Habilitar/deshabilitar soporte multicast (TRUE/FALSE)
MULTICAST_SUPPORT=TRUE
